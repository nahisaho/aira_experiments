{
  "framework_version": "1.0.0",
  "classification_system": "CICES_v5.1_adapted",
  "ecosystem_services": {
    "provisioning": {
      "description": "供給サービス：生態系から直接得られる物質的便益",
      "indicators": [
        {
          "id": "P01",
          "name": "食料生産量",
          "unit": "ton/ha/year",
          "invest_model": "Crop Production",
          "seea_ea_class": "Crop provisioning services",
          "measurement_method": "農業統計 + InVEST Crop Production Percentile Model",
          "spatial_resolution": "30m grid",
          "temporal_resolution": "annual"
        },
        {
          "id": "P02",
          "name": "木材生産量",
          "unit": "m3/ha/year",
          "invest_model": "Forest Carbon Edge Effect (proxy)",
          "seea_ea_class": "Timber provisioning services",
          "measurement_method": "森林簿データ + 成長量モデル",
          "spatial_resolution": "30m grid",
          "temporal_resolution": "annual"
        },
        {
          "id": "P03",
          "name": "淡水供給量",
          "unit": "m3/ha/year",
          "invest_model": "Annual Water Yield",
          "seea_ea_class": "Water supply",
          "measurement_method": "InVEST Annual Water Yield Model (Budyko curve)",
          "spatial_resolution": "30m grid",
          "temporal_resolution": "annual"
        },
        {
          "id": "P04",
          "name": "非木材林産物",
          "unit": "kg/ha/year",
          "invest_model": null,
          "seea_ea_class": "Wild plants, algae, fungi provisioning",
          "measurement_method": "フィールド調査 + 地域統計",
          "spatial_resolution": "landscape unit",
          "temporal_resolution": "annual"
        }
      ]
    },
    "regulating": {
      "description": "調整サービス：生態系プロセスの調整による便益",
      "indicators": [
        {
          "id": "R01",
          "name": "炭素貯留・吸収量",
          "unit": "tC/ha, tC/ha/year",
          "invest_model": "Carbon Storage and Sequestration",
          "seea_ea_class": "Global climate regulation",
          "measurement_method": "InVEST Carbon Model (4 carbon pools)",
          "spatial_resolution": "30m grid",
          "temporal_resolution": "annual/decadal",
          "carbon_pools": ["above_ground_biomass", "below_ground_biomass", "soil_organic_carbon", "dead_organic_matter"]
        },
        {
          "id": "R02",
          "name": "土壌浸食防止量",
          "unit": "ton/ha/year avoided",
          "invest_model": "Sediment Delivery Ratio (SDR)",
          "seea_ea_class": "Soil erosion control",
          "measurement_method": "InVEST SDR Model (USLE-based)",
          "spatial_resolution": "30m grid",
          "temporal_resolution": "annual"
        },
        {
          "id": "R03",
          "name": "水質浄化能力",
          "unit": "kg-N/ha/year, kg-P/ha/year retained",
          "invest_model": "Nutrient Delivery Ratio (NDR)",
          "seea_ea_class": "Water purification",
          "measurement_method": "InVEST NDR Model",
          "spatial_resolution": "30m grid",
          "temporal_resolution": "annual"
        },
        {
          "id": "R04",
          "name": "花粉媒介サービス",
          "unit": "pollinator abundance index (0-1)",
          "invest_model": "Crop Pollination",
          "seea_ea_class": "Pollination",
          "measurement_method": "InVEST Pollination Model",
          "spatial_resolution": "30m grid",
          "temporal_resolution": "seasonal"
        },
        {
          "id": "R05",
          "name": "洪水調節量",
          "unit": "m3 flood volume mitigated",
          "invest_model": "Urban Flood Risk Mitigation",
          "seea_ea_class": "Flood control",
          "measurement_method": "InVEST Flood Risk + ARIES k.LAB",
          "spatial_resolution": "30m grid",
          "temporal_resolution": "event-based"
        },
        {
          "id": "R06",
          "name": "生息地品質指数",
          "unit": "habitat quality index (0-1)",
          "invest_model": "Habitat Quality",
          "seea_ea_class": "Maintaining nursery populations and habitats",
          "measurement_method": "InVEST Habitat Quality Model",
          "spatial_resolution": "30m grid",
          "temporal_resolution": "decadal"
        }
      ]
    },
    "cultural": {
      "description": "文化的サービス：生態系から得られる非物質的便益",
      "indicators": [
        {
          "id": "C01",
          "name": "レクリエーション価値",
          "unit": "person-days/ha/year, JPY/visit",
          "invest_model": "Recreation Model",
          "seea_ea_class": "Recreation-related services",
          "measurement_method": "InVEST Recreation + トラベルコスト法",
          "spatial_resolution": "1km grid",
          "temporal_resolution": "annual"
        },
        {
          "id": "C02",
          "name": "景観美的価値",
          "unit": "scenic beauty index (0-1)",
          "invest_model": "Scenic Quality",
          "seea_ea_class": "Visual amenity services",
          "measurement_method": "InVEST Scenic Quality (viewshed analysis)",
          "spatial_resolution": "30m grid",
          "temporal_resolution": "static/decadal"
        },
        {
          "id": "C03",
          "name": "伝統的知識・文化遺産価値",
          "unit": "WTP (JPY/household/year)",
          "invest_model": null,
          "seea_ea_class": "Heritage and intrinsic value",
          "measurement_method": "選択実験 (Choice Experiment) + CVM",
          "spatial_resolution": "community unit",
          "temporal_resolution": "5-year survey cycle"
        },
        {
          "id": "C04",
          "name": "教育・研究価値",
          "unit": "research visits/year, educational programs/year",
          "invest_model": null,
          "seea_ea_class": "Education and research",
          "measurement_method": "施設利用統計 + アンケート調査",
          "spatial_resolution": "site-level",
          "temporal_resolution": "annual"
        }
      ]
    }
  }
}
