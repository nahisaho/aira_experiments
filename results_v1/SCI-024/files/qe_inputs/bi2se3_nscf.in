&control
   calculation = 'nscf'
   prefix      = 'bi2se3'
   outdir      = './tmp'
   pseudo_dir  = './pseudos'
   verbosity   = 'high'
/

&system
   ibrav       = 0
   nat         = 5
   ntyp        = 2
   ecutwfc     = 60.0
   ecutrho     = 600.0
   occupations = 'tetrahedra_opt'
   noncolin    = .true.
   lspinorb    = .true.
   nbnd        = 40
/

&electrons
   conv_thr         = 1.0d-10
   diago_full_acc   = .true.
/

