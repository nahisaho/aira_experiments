# Wannier90 input file for Bi2Se3
# Reference: Mostofi et al., Comput. Phys. Commun. 185, 2309 (2014)

seedname = bi2se3

# System description
num_wann  = 22        ! 5 atoms × 4 sp3 orbitals + spin (with SOC: 22 WFs)
num_bands = 40

# Fermi energy from QE SCF calculation
fermi_energy = [FERMI_ENERGY_FROM_QE]

# Disentanglement
dis_win_max    =  4.0    ! eV above Fermi level
dis_win_min    = -4.0    ! eV below Fermi level
dis_froz_max   =  1.5
dis_froz_min   = -1.5
dis_num_iter   = 500
dis_mix_ratio  = 0.5

# Wannierization
num_iter       = 1000
num_print_cycles = 50

# Orbital projections for Bi2Se3
# Bi: p orbitals + spin (j=3/2 spinors)
# Se: p orbitals + spin
begin projections
  Bi: l=1, mr=1,2,3
  Se: l=1, mr=1,2,3
end projections

# Plot options
wannier_plot = .true.
wannier_plot_supercell = 3

bands_plot = .true.
bands_num_points = 100

# Berry phase / Z2
berry_task = -z2
berry_kmesh = 6 6 3

# Write hr.dat for WannierTools surface state calculation
write_hr = .true.
write_xyz = .true.

# Lattice vectors
begin unit_cell_cart
angstrom
   2.069000  -3.584233   0.000000
   2.069000   3.584233   0.000000
   0.000000   0.000000  28.640000
end unit_cell_cart

begin atoms_frac
   Bi   0.399700   0.399700   0.399700
   Bi   0.600300   0.600300   0.600300
   Se   0.000000   0.000000   0.000000
   Se   0.206800   0.206800   0.206800
   Se   0.793200   0.793200   0.793200
end atoms_frac

begin kpoint_path
  G 0.000 0.000 0.000  Z 0.000 0.000 0.500
  Z 0.000 0.000 0.500  F 0.500 0.000 0.500
  F 0.500 0.000 0.500  L 0.500 0.000 0.000
  L 0.500 0.000 0.000  G 0.000 0.000 0.000
end kpoint_path

mp_grid = 8 8 4
