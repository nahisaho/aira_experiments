rule compute_alpha_diversity:
    """
    Alpha diversity metrics: Shannon, Simpson, Chao1, Observed species.
    Healthy Shannon: 3.3-4.3; IBD/CRC: significantly reduced (NatureLM).
    """
    input:
        taxonomy=f"{OUT['classification']}/all_metaphlan4_merged.tsv",
        metadata="metadata/sample_metadata.tsv",
    output:
        f"{OUT['statistics']}/alpha_diversity.tsv",
    conda:
        "envs/statistics.yaml"
    script:
        "scripts/alpha_diversity.R"


rule compute_beta_diversity:
    """
    Beta diversity + PERMANOVA (999 permutations).
    Bray-Curtis, Weighted/Unweighted UniFrac distances.
    """
    input:
        taxonomy=f"{OUT['classification']}/all_metaphlan4_merged.tsv",
        metadata="metadata/sample_metadata.tsv",
    output:
        distances=f"{OUT['statistics']}/beta_diversity_distances.rds",
        permanova=f"{OUT['statistics']}/beta_diversity_permanova.tsv",
        pcoa=f"{OUT['statistics']}/beta_diversity_pcoa.tsv",
    conda:
        "envs/statistics.yaml"
    script:
        "scripts/beta_diversity.R"


rule differential_abundance_maaslin2:
    """
    Differential abundance analysis with MaAsLin2.
    Linear mixed models with fixed effects (disease, age, sex, BMI)
    and random effects (study_id) to control for confounders.
    """
    input:
        taxonomy=f"{OUT['classification']}/all_metaphlan4_merged.tsv",
        pathways=f"{OUT['functional']}/all_humann3_pathways_unstratified.tsv",
        metadata="metadata/sample_metadata.tsv",
    output:
        taxa_results=f"{OUT['statistics']}/differential_abundance_maaslin2.tsv",
        pathway_results=f"{OUT['statistics']}/differential_pathways_maaslin2.tsv",
    conda:
        "envs/statistics.yaml"
    script:
        "scripts/maaslin2_analysis.R"


rule machine_learning_classifier:
    """
    Random Forest classifier for disease prediction from microbiome profiles.
    5-fold cross-validation with stratified splits.
    Reports AUROC ± SD (avoiding overfitting).
    """
    input:
        taxonomy=f"{OUT['classification']}/all_metaphlan4_merged.tsv",
        pathways=f"{OUT['functional']}/all_humann3_pathways_unstratified.tsv",
        metadata="metadata/sample_metadata.tsv",
    output:
        f"{OUT['statistics']}/ml_classifier_results.tsv",
    conda:
        "envs/statistics.yaml"
    script:
        "scripts/ml_classifier.py"
