# LAMMPS Input Script: Concentrated Electrolyte Simulation
# EC/DMC/LiPF6 System with OPLS-AA Force Field (Scaled Charges)

# ============================================================
# 1. Initialization
# ============================================================
units           real
atom_style      full
boundary        p p p

pair_style      lj/cut/coul/long 12.0
bond_style      harmonic
angle_style     harmonic
dihedral_style  opls
improper_style  harmonic
kspace_style    pppm 1.0e-5

special_bonds   lj/coul 0.0 0.0 0.5   # OPLS 1-4 scaling

# ============================================================
# 2. Read Data
# ============================================================
read_data       system.data

# ============================================================
# 3. Force Field Settings
# ============================================================
# Li+ (type 1): ECC scaled charge = 0.8e
# PF6- center P (type 2): part of -0.8e total
# PF6- F atoms (type 3)
# EC atoms (types 4-8)
# DMC atoms (types 9-14)

pair_modify     mix geometric
neighbor        2.0 bin
neigh_modify    every 10 delay 0 check yes

# ============================================================
# 4. Energy Minimization
# ============================================================
thermo          100
thermo_style    custom step temp press pe ke etotal density lx

minimize        1.0e-4 1.0e-6 10000 100000

# ============================================================
# 5. NVT Equilibration (500 ps)
# ============================================================
velocity        all create 298.15 12345 dist gaussian
fix             nvt_eq all nvt temp 298.15 298.15 100.0
timestep        1.0

run             500000
unfix           nvt_eq

# ============================================================
# 6. NPT Equilibration (2 ns)
# ============================================================
fix             npt_eq all npt temp 298.15 298.15 100.0 iso 1.0 1.0 1000.0
timestep        2.0

dump            equil all custom 1000 dump.equil.lammpstrj id type x y z vx vy vz
run             1000000
undump          equil
unfix           npt_eq

# ============================================================
# 7. NPT Production for Structure (20 ns)
# ============================================================
reset_timestep  0
fix             npt_prod all npt temp 298.15 298.15 100.0 iso 1.0 1.0 1000.0

# RDF computation
compute         rdf_LiO all rdf 200 1 4 1 9    # Li-O(EC), Li-O(DMC)
fix             rdf_avg all ave/time 100 100 10000 c_rdf_LiO[*] file rdf_Li_O.dat mode vector

dump            prod all custom 500 dump.prod.lammpstrj id type x y z
thermo          1000

run             10000000
undump          prod
unfix           npt_prod
unfix           rdf_avg

# ============================================================
# 8. NVE Production for Transport (50 ns)
# ============================================================
reset_timestep  0

# MSD computation
compute         msd_Li Li msd
compute         msd_PF6 PF6 msd
fix             msd_out all ave/time 1 1 100 &
                c_msd_Li[4] c_msd_PF6[4] &
                file msd_ions.dat

# Velocity output for Green-Kubo
dump            vel_dump all custom 100 dump.velocities.lammpstrj id type vx vy vz

fix             nve_prod all nve
timestep        1.0

run             50000000
