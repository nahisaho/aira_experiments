; GROMACS MDP file for Energy Minimization
; Concentrated Electrolyte Simulation Protocol

integrator      = steep
nsteps          = 50000
emtol           = 100.0       ; kJ/mol/nm
emstep          = 0.01        ; nm

nstlist         = 10
cutoff-scheme   = Verlet
ns_type         = grid
rlist           = 1.2

coulombtype     = PME
rcoulomb        = 1.2
pme_order       = 4
fourierspacing  = 0.12

vdwtype         = Cut-off
rvdw            = 1.2
DispCorr        = EnerPres

constraints     = none
