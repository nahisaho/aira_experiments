; GROMACS MDP: NPT Production (20 ns)

integrator      = md
dt              = 0.002
nsteps          = 10000000
nstxout-compressed = 500
nstenergy       = 500
nstlog          = 500

nstlist         = 20
cutoff-scheme   = Verlet
rlist           = 1.2

coulombtype     = PME
rcoulomb        = 1.2
pme_order       = 6
fourierspacing  = 0.10

vdwtype         = Cut-off
rvdw            = 1.2
DispCorr        = EnerPres

tcoupl          = Nose-Hoover
tc-grps         = System
tau_t           = 1.0
ref_t           = 298.15

pcoupl          = Parrinello-Rahman
pcoupltype      = isotropic
tau_p           = 5.0
ref_p           = 1.0
compressibility = 4.5e-5

constraints     = h-bonds
constraint_algorithm = LINCS
lincs_iter      = 1
lincs_order     = 4

gen_vel         = no
continuation    = yes
pbc             = xyz
