; GROMACS MDP file for em
; EC/DMC/LiPF6 electrolyte simulation

integrator                = steep
nsteps                    = 50000
emtol                     = 100.0
emstep                    = 0.01
cutoff-scheme             = Verlet
nstlist                   = 20
ns_type                   = grid
coulombtype               = PME
rcoulomb                  = 1.2
rvdw                      = 1.2
pbc                       = xyz
DispCorr                  = EnerPres
constraints               = h-bonds
constraint_algorithm      = LINCS
