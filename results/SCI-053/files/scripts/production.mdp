; GROMACS MDP file for production
; EC/DMC/LiPF6 electrolyte simulation

integrator                = md
nsteps                    = 50000000
dt                        = 0.001
tcoupl                    = Nose-Hoover
ref_t                     = 298.15
tau_t                     = 1.0
pcoupl                    = Parrinello-Rahman
ref_p                     = 1.0
tau_p                     = 5.0
compressibility           = 4.5e-5
nstxout                   = 5000
nstvout                   = 5000
nstenergy                 = 1000
nstlog                    = 1000
cutoff-scheme             = Verlet
nstlist                   = 20
ns_type                   = grid
coulombtype               = PME
rcoulomb                  = 1.2
rvdw                      = 1.2
pbc                       = xyz
DispCorr                  = EnerPres
constraints               = h-bonds
constraint_algorithm      = LINCS
