; GROMACS MDP file for nvt
; EC/DMC/LiPF6 electrolyte simulation

integrator                = md
nsteps                    = 500000
dt                        = 0.001
tcoupl                    = v-rescale
ref_t                     = 298.15
tau_t                     = 0.1
gen_vel                   = yes
gen_temp                  = 298.15
cutoff-scheme             = Verlet
nstlist                   = 20
ns_type                   = grid
coulombtype               = PME
rcoulomb                  = 1.2
rvdw                      = 1.2
pbc                       = xyz
DispCorr                  = EnerPres
constraints               = h-bonds
constraint_algorithm      = LINCS
