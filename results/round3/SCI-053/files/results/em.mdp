
; GROMACS .mdp — EM phase
; Generated for concentrated electrolyte simulation
; System: EC/DMC/LiPF6
; Temperature: 298.15 K
title                    = Electrolyte simulation — em
define                   =

; Run parameters
integrator               = steep
nsteps                   = 5000000
dt                       = 0.001
comm-mode                = Linear
nstcomm                  = 100

; Output control
nstxout                  = 0
nstvout                  = 0
nstfout                  = 0
nstlog                   = 5000
nstenergy                = 500
nstxout-compressed       = 10000
compressed-x-precision   = 1000

; Neighbor searching
cutoff-scheme            = Verlet
ns-type                  = grid
nstlist                  = 20
pbc                      = xyz
rlist                    = 1.2

; Electrostatics
coulombtype              = PME
rcoulomb                 = 1.2
ewald-geometry           = 3d
pme-order                = 4
fourierspacing           = 0.12
ewald-rtol               = 1e-05

; VDW interactions
vdwtype                  = Cut-off
rvdw                     = 1.2
DispCorr                 = EnerPres

; Temperature coupling

emtol                    = 100.0
emstep                   = 0.01
pcoupl                   = no

; Constraints (LINCS for rigid bonds)
constraints              = h-bonds
constraint-algorithm     = LINCS
lincs-iter               = 1
lincs-order              = 4
lincs-warnangle          = 30

; Free energy (disabled for standard runs)
free-energy              = no
